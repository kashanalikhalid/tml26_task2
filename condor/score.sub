# HTCondor submit description for the TML 2026 Task 2 stolen-model scoring job.
# Mirrors the Task 1 GPU template: docker universe + the official PyTorch image
# + the cluster-specific mount/site requirements.

universe       = docker
docker_image   = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel

executable     = /bin/bash
arguments      = /home/atml_team061/tml26_task2/condor/run_score.sh

initialdir     = /home/atml_team061/tml26_task2

output         = /home/atml_team061/tml26_task2/runlogs/score.$(ClusterId).$(ProcId).out
error          = /home/atml_team061/tml26_task2/runlogs/score.$(ClusterId).$(ProcId).err
log            = /home/atml_team061/tml26_task2/runlogs/score.$(ClusterId).log

should_transfer_files = YES
getenv         = True

request_GPUs   = 1
request_CPUs   = 4
request_memory = 16G

requirements   = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true

queue 1
