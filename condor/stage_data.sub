# HTCondor submit description for the TML 2026 Task 2 NFS-cache stage job.
# Pure I/O / network: downloads SprintML/tml26_task2 straight into the shared
# home filesystem so subsequent scoring jobs can skip the 16 GB download.
#
# No GPU, modest CPU/memory. Resumable via `curl -C -` so it's safe to kill
# and resubmit if the contended NFS writes time out.

universe       = docker
docker_image   = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel

executable     = /bin/bash
arguments      = /home/atml_team061/tml26_task2/condor/run_stage.sh

initialdir     = /home/atml_team061/tml26_task2

output         = /home/atml_team061/tml26_task2/runlogs/stage.$(ClusterId).$(ProcId).out
error          = /home/atml_team061/tml26_task2/runlogs/stage.$(ClusterId).$(ProcId).err
log            = /home/atml_team061/tml26_task2/runlogs/stage.$(ClusterId).log

should_transfer_files = YES
getenv         = True

request_CPUs   = 1
request_memory = 2G

requirements   = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true

queue 1
